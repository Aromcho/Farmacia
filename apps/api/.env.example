# Base de datos (docker compose levanta Postgres en el puerto 5433)
DATABASE_URL="postgresql://farmacia:farmacia@localhost:5433/farmacia"

# Servidor
PORT=4000
NODE_ENV=development
# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000
# URL pública del sitio (para links de WhatsApp, emails, etc.)
PUBLIC_SITE_URL=http://localhost:3000

# Autenticación del panel admin (¡cambiar en producción!)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Usuario administrador inicial (lo crea el seed)
ADMIN_EMAIL=admin@farmaciaamanciofernandez.com.ar
ADMIN_PASSWORD=Amancio2026!
ADMIN_NAME=Administración

# Carpeta de archivos subidos
UPLOADS_DIR=./uploads
